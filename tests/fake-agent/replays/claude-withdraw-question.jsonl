{"out":{"type":"control_response","response":{"subtype":"success","request_id":{"$":"initialize.request_id"},"response":{}}}}
{"read":"prompt","expect":{"type":"user","message":{"role":"user","content":"Ask before creating a fixture file."}}}
{"out":{"type":"assistant","session_id":"00000000-0000-4000-8000-000000000000","message":{"role":"assistant","content":[{"type":"tool_use","id":"fixture-tool","name":"Bash","input":{"command":"touch fixture.txt"}}]}}}
{"out":{"type":"control_request","request_id":"fixture-permission","request":{"subtype":"can_use_tool","tool_name":"Bash","input":{"command":"touch fixture.txt"}}}}
{"gate":"withdraw-question"}
