{
  "extends": "@tokamak/sdk/tsconfig.window.json",
  "compilerOptions": {
    "types": ["node"],
    // `plugin:chat/*` types are generated by the plugin build into .tokamak/types.
    "paths": {
      "plugin:*/contracts": ["../../.tokamak/types/*/contracts.d.ts"],
      "plugin:*/server": ["../../.tokamak/types/*/server.d.ts"],
      "plugin:*/client": ["../../.tokamak/types/*/client.d.ts"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"]
}
